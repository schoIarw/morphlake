# Service
MORPHLAKE_ENV=development
MORPHLAKE_HOST=0.0.0.0
MORPHLAKE_PORT=8080
MORPHLAKE_ADMIN_PORT=8081
MORPHLAKE_LOG_LEVEL=INFO
MORPHLAKE_MAX_UPLOAD_MB=200
MORPHLAKE_THUMBNAIL_MAX_PIXELS=320
MORPHLAKE_PREVIEW_MAX_CHARS=20000
MORPHLAKE_MODELS_CONFIG=/app/config/models.yaml
MORPHLAKE_ADMIN_DB_CONFIG=/app/config/database.yaml
# Optional backward-compatible SQLite override; leave empty when using database.yaml.
MORPHLAKE_ADMIN_DB_PATH=
MORPHLAKE_DB_CREDENTIAL_KEY=
MORPHLAKE_ADMIN_USERNAME=admin
MORPHLAKE_ADMIN_PASSWORD=replace-with-a-strong-password
MORPHLAKE_ADMIN_SESSION_SECRET=replace-with-a-separate-long-random-secret
MORPHLAKE_ADMIN_SESSION_TTL_SECONDS=28800
MORPHLAKE_ADMIN_COOKIE_SECURE=false
MORPHLAKE_API_BASE_URL=http://morphlake-api:8080
MORPHLAKE_ADMIN_API_TIMEOUT_SECONDS=30
MORPHLAKE_TOKEN_PEPPER=replace-with-a-long-random-secret
MORPHLAKE_TOKEN_ENCRYPTION_SECRET=replace-with-a-separate-key-encryption-secret
MORPHLAKE_METRICS_TOKEN=replace-with-a-separate-metrics-token
MORPHLAKE_DEFAULT_RATE_PERIOD_SECONDS=60
MORPHLAKE_DEFAULT_UPLOAD_REQUESTS=60
MORPHLAKE_DEFAULT_DOWNLOAD_REQUESTS=120
MORPHLAKE_DEFAULT_UPLOAD_BYTES=1073741824
MORPHLAKE_DEFAULT_DOWNLOAD_BYTES=5368709120
MORPHLAKE_TRANSFER_DETAIL_RETENTION_DAYS=30
MORPHLAKE_HEALTH_CHECK_INTERVAL_SECONDS=15
PROMETHEUS_URL=http://prometheus:9090

# Existing MinIO cluster
MINIO_ENDPOINT=minio.example.internal:9000
MINIO_ACCESS_KEY=replace-me
MINIO_SECRET_KEY=replace-me
MINIO_SECURE=false
MINIO_DATA_BUCKET=morphlake-data
MINIO_PAIMON_BUCKET=morphlake-paimon
MINIO_REGION=

# Five-table Paimon model. The service creates and validates all tables at startup.
PAIMON_DATABASE=morphlake
PAIMON_TABLE=multimodal_asset_descriptor
PAIMON_TEXT_TABLE=multimodal_text_segment
PAIMON_IMAGE_TABLE=multimodal_image_feature
PAIMON_AUDIO_TABLE=multimodal_audio_feature
PAIMON_AUDIT_TABLE=multimodal_transfer_audit
PAIMON_WAREHOUSE=s3://morphlake-paimon/warehouse
PAIMON_DOMAIN_SHARDS=32
PAIMON_VECTOR_INDEX_TYPE=ivf-sq
PAIMON_INDEX_BUILD_INTERVAL_SECONDS=300
PAIMON_INDEX_ROW_COUNT_PER_SHARD=500000
PAIMON_AUDIT_FLUSH_INTERVAL_SECONDS=5
PAIMON_AUDIT_BATCH_SIZE=1000
PAIMON_TEXT_VECTOR_DIMENSION=384
PAIMON_IMAGE_VECTOR_DIMENSION=512
PAIMON_AUDIO_VECTOR_DIMENSION=384

# OpenAI-compatible model endpoints. The checked-in development profile uses
# deterministic hash embeddings; change provider values in config/models.yaml.
TEXT_SUMMARY_PROVIDER=extractive
TEXT_SUMMARY_MODEL=morphlake-extractive-summary-v1
EMBEDDING_API_BASE=https://model-gateway.example.internal/v1
EMBEDDING_API_KEY=replace-me
TEXT_EMBEDDING_MODEL=text-embedding-model
IMAGE_EMBEDDING_MODEL=image-embedding-model
AUDIO_TRANSCRIPTION_MODEL=whisper-model
