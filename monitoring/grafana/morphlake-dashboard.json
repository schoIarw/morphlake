{
  "annotations": {"list": []},
  "description": "MorphLake API、传输、依赖和管理服务监控",
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"mappings": [], "thresholds": {"mode": "absolute", "steps": [{"color": "red"}, {"color": "green", "value": 1}]}}, "overrides": []},
      "gridPos": {"h": 4, "w": 4, "x": 0, "y": 0},
      "id": 1,
      "options": {"colorMode": "background", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"], "values": false}},
      "targets": [{"expr": "min(up{job=~\"morphlake.*\"})", "refId": "A"}],
      "title": "服务实例状态",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []},
      "gridPos": {"h": 4, "w": 4, "x": 4, "y": 0},
      "id": 2,
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "values": false}},
      "targets": [{"expr": "sum(rate(morphlake_http_requests_total[5m]))", "refId": "A"}],
      "title": "API 请求速率",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "Bps"}, "overrides": []},
      "gridPos": {"h": 4, "w": 4, "x": 8, "y": 0},
      "id": 3,
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "values": false}},
      "targets": [{"expr": "sum(rate(morphlake_transfer_bytes_total{operation=\"upload\",status=\"success\"}[5m]))", "refId": "A"}],
      "title": "上传速率",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "Bps"}, "overrides": []},
      "gridPos": {"h": 4, "w": 4, "x": 12, "y": 0},
      "id": 4,
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "values": false}},
      "targets": [{"expr": "sum(rate(morphlake_transfer_bytes_total{operation=\"download\",status=\"success\"}[5m]))", "refId": "A"}],
      "title": "下载速率",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "gridPos": {"h": 4, "w": 4, "x": 16, "y": 0},
      "id": 5,
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "values": false}},
      "targets": [{"expr": "morphlake_transfer_audit_backlog", "refId": "A"}],
      "title": "Paimon 审计积压",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "gridPos": {"h": 4, "w": 4, "x": 20, "y": 0},
      "id": 6,
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "values": false}},
      "targets": [{"expr": "time() - morphlake_index_last_success_timestamp_seconds", "refId": "A"}],
      "title": "距上次索引成功",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
      "id": 7,
      "targets": [{"expr": "sum by (operation, business_domain, department, status) (rate(morphlake_transfer_requests_total[5m]))", "legendFormat": "{{operation}} {{business_domain}}/{{department}} {{status}}", "refId": "A"}],
      "title": "各业务域/部门传输请求",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "Bps"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
      "id": 8,
      "targets": [{"expr": "sum by (operation, business_domain, department) (rate(morphlake_transfer_bytes_total{status=\"success\"}[5m]))", "legendFormat": "{{operation}} {{business_domain}}/{{department}}", "refId": "A"}],
      "title": "各业务域/部门传输流量",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"min": 0, "max": 1}, "overrides": []},
      "gridPos": {"h": 7, "w": 8, "x": 0, "y": 12},
      "id": 9,
      "targets": [{"expr": "morphlake_component_up", "legendFormat": "{{job}} / {{component}}", "refId": "A"}],
      "title": "组件连通性",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "gridPos": {"h": 7, "w": 8, "x": 8, "y": 12},
      "id": 10,
      "targets": [{"expr": "histogram_quantile(0.95, sum by (le, route) (rate(morphlake_http_request_duration_seconds_bucket[5m])))", "legendFormat": "{{route}}", "refId": "A"}],
      "title": "HTTP P95 时延",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {}, "overrides": []},
      "gridPos": {"h": 7, "w": 8, "x": 16, "y": 12},
      "id": 11,
      "targets": [
        {"expr": "rate(process_cpu_seconds_total{job=~\"morphlake.*\"}[5m])", "legendFormat": "CPU {{job}}", "refId": "A"},
        {"expr": "process_resident_memory_bytes{job=~\"morphlake.*\"}", "legendFormat": "RSS {{job}}", "refId": "B"}
      ],
      "title": "进程 CPU / 内存",
      "type": "timeseries"
    }
  ],
  "refresh": "15s",
  "schemaVersion": 39,
  "tags": ["morphlake", "paimon", "minio"],
  "templating": {
    "list": [
      {
        "current": {},
        "label": "Prometheus",
        "name": "DS_PROMETHEUS",
        "options": [],
        "query": "prometheus",
        "type": "datasource"
      }
    ]
  },
  "time": {"from": "now-6h", "to": "now"},
  "timezone": "browser",
  "title": "MorphLake 运行监控",
  "uid": "morphlake-operations",
  "version": 1
}
