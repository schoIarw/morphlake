# MorphLake service
MORPHLAKE_ENV=local-ollama
MORPHLAKE_HOST=0.0.0.0
MORPHLAKE_PORT=8080
MORPHLAKE_LOG_LEVEL=INFO
MORPHLAKE_API_KEY=
MORPHLAKE_MAX_UPLOAD_MB=200
MORPHLAKE_MODELS_CONFIG=/app/config/models.ollama.yaml

# Existing MinIO. Replace these values with the reachable test cluster.
MINIO_ENDPOINT=minio.example.internal:9000
MINIO_ACCESS_KEY=replace-me
MINIO_SECRET_KEY=replace-me
MINIO_SECURE=false
MINIO_DATA_BUCKET=morphlake-data
MINIO_PAIMON_BUCKET=morphlake-paimon
MINIO_REGION=

# Use separate local-test tables because Nomic produces 768-dimensional
# vectors, unlike the default development profile.
PAIMON_DATABASE=morphlake
PAIMON_TABLE=multimodal_asset_descriptor_ollama
PAIMON_TEXT_TABLE=multimodal_text_segment_ollama
PAIMON_IMAGE_TABLE=multimodal_image_feature_ollama
PAIMON_AUDIO_TABLE=multimodal_audio_feature_ollama
PAIMON_WAREHOUSE=s3://morphlake-paimon/warehouse
PAIMON_DOMAIN_SHARDS=32
PAIMON_VECTOR_INDEX_TYPE=ivf-sq
PAIMON_INDEX_BUILD_INTERVAL_SECONDS=30
PAIMON_INDEX_ROW_COUNT_PER_SHARD=500000
PAIMON_TEXT_VECTOR_DIMENSION=768
PAIMON_IMAGE_VECTOR_DIMENSION=768
PAIMON_AUDIO_VECTOR_DIMENSION=384

# Ollama runs on macOS; MorphLake reaches the host from Docker Desktop.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_OPENAI_BASE_URL=http://host.docker.internal:11434/v1
TEXT_EMBEDDING_MODEL=nomic-embed-text:latest
IMAGE_VISION_MODEL=minicpm-v:8b
